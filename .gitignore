# Raw and processed data (large; rebuilt by scripts)
data/
# Secrets
.env
*.env
!*.env.example
# Python
__pycache__/
.venv/
# Vendored pelias/docker CLI (fetched by scripts/bootstrap.sh)
/vendor/
# Rendered Pelias config (may contain the OA token)
projects/*/pelias.json
# pgeo local secrets
pgeo/.env
*.secrets
# pgeo-tune output (generated from pgeo/tuning/profiles/*.toml)
pgeo/docker/db/tuning/active.conf
pgeo/tuning/active.vars
pgeo/tuning/profiles/auto.toml
