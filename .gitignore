# Raw and processed data (large; rebuilt by scripts)
data/
# Secrets
.env
*.env
!*.env.example
# Python
__pycache__/
.venv/
# Vendored pelias/docker CLI (fetched by scripts/bootstrap.sh)
/vendor/
# Rendered Pelias config (may contain the OA token)
projects/*/pelias.json
# pgeo local secrets
pgeo/.env
*.secrets
# pgeo-tune output (generated from pgeo/tuning/profiles/*.toml)
pgeo/docker/db/tuning/active.conf
pgeo/tuning/active.vars
pgeo/tuning/profiles/auto.toml
# report build output (regenerated by scripts/build_report.sh)
report/build/
report/.venv/
# report inputs are small and belong in git (the rule above matches every data/ directory)
!report/data/

# The study's measurement results belong in git: they are what the report's numbers are
# computed from, and the engines that produced them (a Nominatim database, a Photon index,
# a tuned Elasticsearch) are not reproducible from this repository alone. Checked before
# committing: these hold case ids, hit/miss flags, distances and timings - no query text, so
# no searched addresses. Raw inputs, indexes and database directories stay ignored.
!data/
data/*
!data/accuracy/
!data/accuracy/**
!data/loadtest/
!data/loadtest/**

# Slidev deck. slides/dist IS committed: the static build is what gets published, so the deck
# can be read from the repository (and GitHub Pages) without Node or npm install.
slides/node_modules/
slides/.slidev/

# Real network details stay out of the published repository (see the .example files)
infra/ansible/inventory/hosts.yml
infra/ansible/group_vars/pelias/local.yml
