      "params": {
        "text": "Burlington, Vermont"
      },
      "want": "Burlington, VT",
      "layer": "locality"
    },
    {
      "path": "search",
      "params": {
        "text": "Concord, New Hampshire"
      },
      "want": "Concord, NH",
      "layer": "locality"
    },
    {
      "path": "search",
      "params": {
        "text": "Montpelier, VT"
      },
      "want": "Montpelier",
      "layer": "locality"
    },
    {
      "path": "search",
      "params": {
        "text": "Manchestr, NH"
      },
      "want": "Manchester",
      "layer": "locality"
    },
    {
      "path": "search",
      "params": {
        "text": "main st",
        "focus.point.lat": "44.4759",
        "focus.point.lon": "-73.2121"
      },
      "want": "Burlington",
      "layer": "street"
    },
    {
      "path": "autocomplete",
      "params": {
        "text": "burling"
      },
      "want": "Burlington",
      "layer": "locality"
    },
    {
      "path": "reverse",
      "params": {
        "point.lat": "44.4759",
        "point.lon": "-73.2121"
      },
      "want": "Burlington"
    },
    {
      "path": "reverse",
      "params": {
        "point.lat": "43.2081",
        "point.lon": "-71.5376"
      },
      "want": "Concord"
    }
  ]
}
