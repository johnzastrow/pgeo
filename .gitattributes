# Files that run inside Linux containers or on Linux hosts must keep LF line endings, even in a
# Windows checkout with core.autocrlf=true: a CRLF shebang fails with "bash\r: not found".
*.sh        text eol=lf
*.psql      text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.j2        text eol=lf
*.caddy     text eol=lf
Dockerfile  text eol=lf
