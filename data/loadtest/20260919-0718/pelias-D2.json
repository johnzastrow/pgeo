{
 "logger": {
  "level": "info",
  "timestamp": false
 },
 "esclient": {
  "apiVersion": "7.5",
  "hosts": [
   {
    "host": "elasticsearch"
   }
  ]
 },
 "elasticsearch": {
  "settings": {
   "index": {
    "refresh_interval": "10s",
    "number_of_replicas": "0",
    "number_of_shards": "1"
   }
  }
 },
 "acceptance-tests": {
  "endpoints": {
   "docker": "http://api:4000/v1/"
  }
 },
 "api": {
  "services": {
   "placeholder": {
    "url": "http://placeholder:4100"
   },
   "pip": {
    "url": "http://pip:4200"
   },
   "interpolation": {
    "url": "http://interpolation:4300"
   },
   "libpostal": {
    "url": "http://libpostal:4400"
   }
  },
  "targets": {
   "auto_discover": true
  },
  "indexName": "pelias_d2"
 },
 "imports": {
  "adminLookup": {
   "enabled": true
  },
  "blacklist": {
   "files": [
    "/data/blacklist/osm.txt"
   ]
  },
  "openstreetmap": {
   "download": [
    {
     "sourceURL": "https://download.geofabrik.de/north-america/us/maine-latest.osm.pbf"
    }
   ],
   "leveldbpath": "/tmp",
   "datapath": "/data/openstreetmap",
   "import": [
    {
     "filename": "maine-latest.osm.pbf"
    }
   ]
  },
  "openaddresses": {
   "datapath": "/data/openaddresses",
   "files": [
    "us/me/statewide",
    "us/me/city_of_biddeford"
   ]
  },
  "polyline": {
   "datapath": "/data/polylines",
   "files": [
    "extract.0sv"
   ]
  },
  "whosonfirst": {
   "datapath": "/data/whosonfirst",
   "countryCode": "US",
   "importPostalcodes": true,
   "importPlace": [
    "85688769"
   ]
  },
  "csv": {
   "datapath": "/data/csv",
   "files": [
    "gnis.csv",
    "zcta.csv",
    "overture.csv"
   ],
   "download": []
  },
  "transit": {
   "datapath": "/data/transit",
   "feeds": []
  },
  "interpolation": {
   "download": {
    "tiger": {
     "datapath": "/data/tiger",
     "states": [
      {
       "state_code": 23
      }
     ]
    }
   }
  }
 }
}