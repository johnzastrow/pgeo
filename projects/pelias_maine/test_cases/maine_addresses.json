{
  "name": "/v1/search addresses (Maine)",
  "description": "Well-known street addresses",
  "priorityThresh": 1,
  "normalizers": {
    "name": [
      "toUpperCase",
      "removeOrdinals",
      "stripPunctuation",
      "abbreviateDirectionals",
      "abbreviateStreetSuffixes"
    ]
  },
  "tests": [
    {
      "id": 1,
      "status": "pass",
      "user": "pelias_maine",
      "in": {
        "text": "389 Congress St, Portland, ME"
      },
      "expected": {
        "properties": [
          {
            "layer": "address",
            "housenumber": "389",
            "locality": "Portland"
          }
        ]
      }
    },
    {
      "id": 2,
      "status": "pass",
      "user": "pelias_maine",
      "in": {
        "text": "210 State St, Augusta, ME"
      },
      "expected": {
        "properties": [
          {
            "layer": "address",
            "housenumber": "210",
            "locality": "Augusta"
          }
        ]
      }
    },
    {
      "id": 3,
      "status": "pass",
      "user": "pelias_maine",
      "in": {
        "text": "73 Harlow St, Bangor, Maine"
      },
      "expected": {
        "properties": [
          {
            "layer": "address",
            "housenumber": "73",
            "locality": "Bangor"
          }
        ]
      }
    },
    {
      "id": 4,
      "status": "fail",
      "user": "pelias_maine",
      "description": "Baseline 2026-09-18: house number absent in the named town; Pelias returns 12 Park Street, Fairfield with confidence 1.0 instead of a Bar Harbor street/interpolated result (town is a boost, not a filter; confidence ignores the town mismatch).",
      "in": {
        "text": "12 Park St, Bar Harbor, ME"
      },
      "expected": {
        "properties": [
          {
            "locality": "Bar Harbor"
          }
        ]
      }
    },
    {
      "id": 5,
      "status": "pass",
      "user": "pelias_maine",
      "in": {
        "text": "32 Park St, Bar Harbor, ME"
      },
      "expected": {
        "properties": [
          {
            "layer": "address",
            "housenumber": "32",
            "locality": "Bar Harbor"
          }
        ]
      }
    }
  ]
}
