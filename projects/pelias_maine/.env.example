# Copy to .env (chmod 600). Never commit .env.
COMPOSE_PROJECT_NAME=pelias_maine
# Absolute path to the Pelias data directory (downloads, prepared DBs, ES data).
DATA_DIR=/absolute/path/to/pelias_maine/data/pelias
OPENADDRESSES_PARALLELISM=2
CSV_PARALLELISM=1
# Elasticsearch heap: 4g on the 31 GB workstation build, 2g on the 10 GB VM.
ES_HEAP=2g
