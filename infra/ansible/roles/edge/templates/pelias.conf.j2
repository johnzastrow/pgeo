# Managed by Ansible (role: edge)
# Client -> HTTPS -> wharf Caddy -> HTTP -> this server -> Pelias API on 127.0.0.1:4000
# Local equivalent for development: scripts/dev/nginx.dev.conf (keep headers/CSP in sync).

# Rate limits keyed on the real client IP (restored from X-Forwarded-For below).
limit_req_zone $binary_remote_addr zone=pelias_search:10m rate={{ edge_rate_search }}r/s;
limit_req_zone $binary_remote_addr zone=pelias_autocomplete:10m rate={{ edge_rate_autocomplete }}r/s;
limit_req_status 429;

# Only the TLS terminator may connect. Checked against the TCP peer
# ($realip_remote_addr), not $remote_addr: the realip module below rewrites
# $remote_addr to the end client, which would make allow/deny reject every real user.
geo $realip_remote_addr $edge_peer_allowed {
    default 0;
{% for src in edge_allowed_sources %}
    {{ src }} 1;
{% endfor %}
}

upstream pelias_api {
    server 127.0.0.1:4000;
    keepalive 16;
}
{% if pgeo_enabled | default(false) | bool %}

# pgeo pure-SQL API (PostgREST on 127.0.0.1:4600), served under /pgeo/v1/*. PostgREST keeps only
# the last segment of dotted parameters, so boundary.circle.lat/lon would collide with
# focus.point.lat/lon: rename them on search, structured and autocomplete (docs/PELIAS_COMPATIBILITY.md).
upstream pgeo_rest {
    server 127.0.0.1:4600;
    keepalive 16;
}
map $args $pgeo_args_1 {
    "~^(?<c1a>.*?)boundary\.circle\.lat=(?<c1b>.*)$" "${c1a}circle_lat=${c1b}";
    default $args;
}
map $pgeo_args_1 $pgeo_args_2 {
    "~^(?<c2a>.*?)boundary\.circle\.lon=(?<c2b>.*)$" "${c2a}circle_lon=${c2b}";
    default $pgeo_args_1;
}
map $pgeo_args_2 $pgeo_circle_args {
    "~^(?<c3a>.*?)boundary\.circle\.radius=(?<c3b>.*)$" "${c3a}circle_radius=${c3b}";
    default $pgeo_args_2;
}
{% endif %}

server {
    listen {{ ansible_facts['default_ipv4']['address'] }}:{{ edge_listen_port }};
    server_name {{ edge_server_name }};
    server_tokens off;
    root {{ edge_demo_root }};
    index index.html;

    # Defense in depth alongside UFW (see geo block above).
    if ($edge_peer_allowed = 0) {
        return 403;
    }

{% for proxy in edge_trusted_proxies %}
    set_real_ip_from {{ proxy }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size 4k;
    client_body_timeout 10s;
    client_header_timeout 10s;

    # Security headers at server level so every location inherits them (a location that
    # sets its own add_header would drop these).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_hide_header X-Powered-By;

    location = /v1/autocomplete {
        limit_except GET { deny all; }
        limit_req zone=pelias_autocomplete burst=50 nodelay;
        proxy_pass http://pelias_api;
    }

    location ~ ^/v1/(search|search/structured|reverse|place)$ {
        limit_except GET { deny all; }
        limit_req zone=pelias_search burst=20 nodelay;
        proxy_pass http://pelias_api;
    }

{% if pgeo_enabled | default(false) | bool %}
    # ---- pgeo (same rate limits as Pelias). A parameter the SQL API does not declare makes
    # PostgREST answer 404; turn it into a Pelias-shaped 400.
    location = /pgeo/v1/autocomplete {
        limit_except GET { deny all; }
        limit_req zone=pelias_autocomplete burst=50 nodelay;
        proxy_intercept_errors on;
        error_page 404 = @pgeo_unsupported;
        proxy_pass http://pgeo_rest/rpc/v1_autocomplete?$pgeo_circle_args;
    }
    location = /pgeo/v1/search {
        limit_except GET { deny all; }
        limit_req zone=pelias_search burst=20 nodelay;
        proxy_intercept_errors on;
        error_page 404 = @pgeo_unsupported;
        proxy_pass http://pgeo_rest/rpc/v1_search?$pgeo_circle_args;
    }
    location = /pgeo/v1/search/structured {
        limit_except GET { deny all; }
        limit_req zone=pelias_search burst=20 nodelay;
        proxy_intercept_errors on;
        error_page 404 = @pgeo_unsupported;
        proxy_pass http://pgeo_rest/rpc/v1_search_structured?$pgeo_circle_args;
    }
    location ~ ^/pgeo/v1/(?<pgeo_fn>reverse|place|address)$ {
        limit_except GET { deny all; }
        limit_req zone=pelias_search burst=20 nodelay;
        proxy_intercept_errors on;
        error_page 404 = @pgeo_unsupported;
        proxy_pass http://pgeo_rest/rpc/v1_$pgeo_fn$is_args$args;
    }
    location /pgeo/ {
        return 404;
    }
    location @pgeo_unsupported {
        default_type application/json;
        return 400 '{"geocoding":{"version":"0.2","errors":["unsupported parameter or endpoint: pgeo accepts the documented Pelias parameters"]},"type":"FeatureCollection","features":[]}';
    }

    # Engines for the demo page's switch (announced by the meta tag injected below).
    location = /engines.json {
        default_type application/json;
        expires 5m;
        return 200 '{"engines":[{"label":"Pelias","base":"","kind":"pelias"},{"label":"pgeo (PostgreSQL)","base":"/pgeo","kind":"pgeo"}]}';
    }
{% endif %}

    # Anything else under /v1 (e.g. /v1/nearby, attribution) is not exposed.
    location /v1/ {
        return 404;
    }

    # ES modules: Debian's mime.types has no .mjs entry, and browsers refuse modules
    # served as application/octet-stream.
    location ~* \.mjs$ {
        default_type text/javascript;
        expires 1h;
        try_files $uri =404;
    }

    # Vendored libraries, fonts, glyphs, sprites: versioned by scripts/vendor_web.sh.
    location /vendor/ {
        expires 7d;
        try_files $uri =404;
    }

    # PMTiles basemap: served statically; nginx answers the HTTP range requests it needs.
    location /tiles/ {
        expires 1d;
        try_files $uri =404;
    }

    # Demo page. Same origin as the API, so no CORS is needed.
    location / {
        limit_except GET { deny all; }
        expires 5m;
{% if pgeo_enabled | default(false) | bool %}
        # Announce the engine switch to the page (served unmodified when pgeo is disabled).
        sub_filter '</head>' '<meta name="demo-engines" content="/engines.json"></head>';
        sub_filter_once on;
{% endif %}
        try_files $uri $uri/ =404;
    }
}
