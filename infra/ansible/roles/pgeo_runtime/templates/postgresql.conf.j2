# Managed by Ansible (role: pgeo_runtime). Base settings as pgeo/docker/db/postgresql.conf, with
# the server profile from group_vars (pgeo/tuning/profiles/{{ pgeo_profile_name }}.toml).
listen_addresses = '*'
port = 5432
max_connections = 40
password_encryption = scram-sha-256

shared_buffers = {{ pgeo_pg.shared_buffers }}
effective_cache_size = {{ pgeo_pg.effective_cache_size }}
work_mem = {{ pgeo_pg.work_mem }}
maintenance_work_mem = 256MB
random_page_cost = 1.1
effective_io_concurrency = 200
jit = off
max_parallel_workers_per_gather = 0

wal_level = minimal               # rebuildable data (restored from a dump)
max_wal_senders = 0
synchronous_commit = off

log_min_duration_statement = 500
log_parameter_max_length = 0      # queries carry addresses: never log parameters
log_parameter_max_length_on_error = 0
log_line_prefix = '%m [%p] %u@%d '
