# Managed by Ansible (role: pelias_runtime)
[Unit]
Description=Pelias Maine query services (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
User={{ pelias_user }}
Group={{ pelias_user }}
WorkingDirectory={{ pelias_home }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans {{ pelias_query_services | join(' ') }}
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
