# Two passwords, both alphanumeric and 24-128 characters. Generate with:
#   tr -dc A-Za-z0-9 </dev/urandom | head -c 32
#
# PGEO_DB_PASSWORD is the owner role, used only by maintenance.
# PGEO_API_PASSWORD is the read-only role PostgREST connects as. It must match the password the
# dump's pgeo_api role was given, or the restore sets it - scripts/pgeo_swap.sh does.
PGEO_DB_PASSWORD=
PGEO_API_PASSWORD=

# Prefixes the compose project and every container. Leave it as pgeo on a dedicated host; change
# it on a machine that also runs this repository's development stack, whose containers are
# already called pgeo_db and pgeo_rest.
PGEO_STACK=pgeo

# Where the edge listens on the host. Keep it on loopback and let a TLS terminator reach it.
PGEO_EDGE_BIND=127.0.0.1
PGEO_EDGE_PORT=8090
PGEO_REST_POOL=10
